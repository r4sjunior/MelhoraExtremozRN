# Copie para .env.local. Sem VITE_SUPABASE_URL o app abre em "modo de teste":
# os dados ficam só no navegador, sem conta e sem servidor.
VITE_SUPABASE_URL=
# A chave pública "publishable" (ou "anon"). NUNCA a "service_role"/"secret".
VITE_SUPABASE_ANON_KEY=
# Opcional: Site Key pública do Cloudflare Turnstile (proteção do login por e-mail).
VITE_TURNSTILE_SITE_KEY=
